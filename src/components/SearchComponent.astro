---
import { getAllReviews } from "../utils/api";
import { reviewDbRowToObject } from "../utils/mappers";

const res = await getAllReviews();
const mappedReviews = res.reviews.map(reviewDbRowToObject);
---

<section class="search-section">
  <form method="GET" class="search-form" id="searchForm">
    <div class="search-form__main">
      <div class="search-input-group">
        <input
          id="searchInput"
          type="search"
          name="q"
          placeholder="Search by restaurant name, cuisine, or location..."
          class="form-input search-input"
          aria-label="Search restaurants"
        />
        <button type="submit" class="btn btn--primary search-btn">Search</button
        >
      </div>
    </div>
  </form>
</section>

<span id="data-reviews" data-reviews={JSON.stringify(mappedReviews)}></span>

<script>
  import type { Review } from "../types/blog";
  import {
    capitalize,
    toCamelCaseAndRemoveSpecialChars,
  } from "../utils/string";
  // Check if the current URL has any query params
  const url = new URL(window.location.href);
  const params = new URLSearchParams(url.search);
  const query = params.get("q");

  const id = document.getElementById("data-reviews");
  if (!id) {
    console.error("Data element not found");
  }

  const reviews = JSON.parse(
    id ? (id.getAttribute("data-reviews") as string) : "",
  ) as Review[];

  console.log("Current search query:", query);

  const performSearch = (term: string) => {
    const filteredReviews = reviews.filter((review) => {
      return (
        review.properties.name.toLowerCase().includes(term) ||
        review.properties.cuisineType.some((cuisine) =>
          cuisine.toLowerCase().includes(term),
        ) ||
        review.properties.suburb.toLowerCase().includes(term)
      );
    });
    const resultsGrid = document.getElementById(
      "resultsGrid",
    ) as HTMLDivElement;
    resultsGrid.innerHTML = ""; // Clear previous results
    filteredReviews.forEach((review) => {
      const reviewCard = document.createElement("article");
      reviewCard.className = "review-card";
      reviewCard.innerHTML = `
        <div class="review-card__body">
          <h3 class="review-card__title">
            <a href="/reviews/${toCamelCaseAndRemoveSpecialChars(review.properties.name)}" class="review-card__link">
              ${review.properties.name}
            </a>
          </h3>
          <div class="review-card__rating">
            <span class="text-sm text-gray-600">Rating: </span>
            <span class="text-primary font-semibold">${review.properties.rating}/10</span>
          </div>
          <div class="review-card__meta">
            <div class="review-card__meta-item">
              <span class="text-sm text-gray-600">Cuisine: </span>
              <span class="text-sm font-medium">${review.properties.cuisineType.map((c) => capitalize(c)).join(" / ")}</span>
            </div>
            <div class="review-card__meta-item">
              <span class="text-sm text-gray-600">Location: </span>
              <span class="text-sm font-medium">${review.properties.suburb}</span>
            </div>
          </div>
        </div>
      `;
      resultsGrid.appendChild(reviewCard);
    });

    if (filteredReviews.length === 0) {
      resultsGrid.innerHTML =
        "<p class='search-no-results'>No results found.</p>";
    }
  };

  if (query) {
    const searchInput = document.getElementById(
      "searchInput",
    ) as HTMLInputElement;
    searchInput.value = query;
    // Wait for the DOM to be fully loaded before performing the search
    window.requestAnimationFrame(() => {
      performSearch(query.toLowerCase());
    });
  }

  const searchForm = document.getElementById("searchForm") as HTMLFormElement;
  searchForm.addEventListener("submit", (event) => {
    event.preventDefault();

    const url = new URL(window.location.href);
    const params = new URLSearchParams(url.search);
    params.set("q", input.value);
    window.history.replaceState({}, "", `${url.pathname}?${params}`);

    performSearch(input.value.toLowerCase());
  });

  const input = document.getElementById("searchInput") as HTMLInputElement;
  input.addEventListener("input", (event) => {
    if (!(event.target instanceof HTMLInputElement)) return;
    const query = event.target.value.toLowerCase();
  });
</script>

<style lang="scss">
  .search-form__main {
    margin-bottom: var(--spacing-6);
  }

  .search-input-group {
    display: flex;
    gap: var(--spacing-4);
    max-width: 600px;
    margin: 0 auto;
  }

  .search-input {
    flex: 1;
    font-size: var(--font-size-lg);
    padding: var(--spacing-4) var(--spacing-6);
    &:focus {
      box-shadow: none;
    }
  }
</style>

<style is:global>
  .search-no-results {
    grid-column: span 3;
  }

  .review-card {
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--spacing-5);
    background-color: var(--color-white);
    transition: background-color 0.2s ease;
    position: relative;
  }

  .review-card:hover {
    background-color: var(--color-gray-100);
  }

  .review-card__body {
    position: relative;
  }

  .review-card__title {
    margin-bottom: var(--spacing-3);
    font-size: var(--font-size-lg);
  }

  .review-card__link {
    color: var(--color-gray-900);
    text-decoration: none;
    z-index: 1;
  }

  .review-card__link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .review-card__rating {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-4);
  }

  .review-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .review-card__meta-item {
    display: flex;
    gap: var(--spacing-2);
    flex-wrap: wrap;
  }
</style>
